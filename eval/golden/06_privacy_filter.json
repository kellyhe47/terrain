{
  "name": "privacy_filter",
  "why": "Rubric §1: entries marked private are excluded from Nora's context by a deterministic filter; universe = the 4 entries in given.",
  "given": {
    "as_of": "2026-08-17T09:00:00-05:00",
    "wellness_entries": [
      { "id": "w1", "type": "sleep", "private": false },
      { "id": "w2", "type": "stress_mood", "private": true },
      { "id": "w3", "type": "soreness", "private": false },
      { "id": "w4", "type": "weight", "private": false }
    ]
  },
  "expect": {
    "result_type": "nora_context_payload",
    "must_include": [
      { "id": "w1", "reason": "not private" },
      { "id": "w3", "reason": "not private" },
      { "id": "w4", "reason": "not private" }
    ],
    "must_exclude": [
      { "id": "w2", "reason": "marked private — must not appear anywhere in the LLM request payload" }
    ],
    "counts_universe": "the 4 entries above",
    "counts": { "shared": 3, "private": 1 },
    "must_include_ui": [
      { "id": "sharing_indicator", "reason": "user can always see what is shared with Nora" }
    ]
  }
}
