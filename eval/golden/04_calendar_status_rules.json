{
  "name": "calendar_status_rules",
  "why": "Rubric §3: scheduling alone never counts as completion; five statuses are distinguishable; universe = the 5 activities defined in given.",
  "given": {
    "as_of": "2026-08-16T20:00:00-05:00",
    "activities": [
      { "id": "a1", "source": "nora", "date": "2026-08-15", "result_logged": { "completed_fully": true } },
      { "id": "a2", "source": "nora", "date": "2026-08-15", "result_logged": { "completed_fully": false, "portion_done": "2 of 4 exercises" } },
      { "id": "a3", "source": "nora", "date": "2026-08-15", "result_logged": null, "user_marked_skipped": true },
      { "id": "a4", "source": "nora", "date": "2026-08-16", "result_logged": null },
      { "id": "a5", "source": "trainee_adhoc", "date": "2026-08-16", "result_logged": { "completed_fully": true } }
    ]
  },
  "expect": {
    "result_type": "calendar_statuses",
    "statuses": { "a1": "completed", "a2": "partial", "a3": "skipped", "a4": "pending", "a5": "trainee_added_completed" },
    "counts_universe": "the 5 activities above",
    "counts": { "pending": 1, "completed": 2, "partial": 1, "skipped": 1 },
    "must_include": [
      { "id": "a4_pending", "reason": "past-scheduled but unlogged activity is still pending, never auto-completed" }
    ]
  }
}
