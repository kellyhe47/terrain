  "given": {
    "as_of": "2026-08-17T08:00:00-05:00",
    "intake": {
      "goal": "build strength, stay lean",
      "days_available_per_week": 4,
      "equipment": "commercial gym",
      "injuries": [ { "area": "right knee", "note": "no deep squatting or jumping" } ],
      "recurring_preferences": [ { "activity": "run", "detail": "3 miles", "frequency": "weekly", "preferred_day": "Saturday" } ]
    },
    "contraindicated_exercise_tags": [ "deep_squat", "plyometric_jump" ]
